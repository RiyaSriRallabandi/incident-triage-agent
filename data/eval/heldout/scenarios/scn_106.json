  "synthetic_deploys": [],
  "ground_truth": {
    "root_cause": "recommendations-service calls an external model-scoring API that enforces a per-client rate limit of 1000 requests/second on its API key. The service's own traffic has grown ~25% week-over-week, and its outbound rate to the scoring API crossed 1000/s (now ~1180/s). The scoring API started returning 429 Too Many Requests for the excess, so ~15% of recommendation requests failed. There was no deploy and no outage - the scoring API is healthy for other clients. The cause is the caller's traffic growth crossing a fixed downstream quota. Recovery required cutting the outbound rate (client-side score caching) and requesting a higher quota.",
    "evidence_path": [
      "recommendations-service WARN: model-scoring API calls returning 429 Too Many Requests",
      "recommendations-service WARN: our outbound rate is 1180/s against a 1000/s per-client limit",
      "downstream_429_rate rises to ~15% as outbound_rps climbs past the limit with traffic growth",
      "the model-scoring API is healthy for other clients - this is our per-client quota, not an outage",
      "429 rate falls after client-side score caching cuts the outbound rate and a quota increase is requested"
    ],
    "fix": "Add client-side caching of scores for repeat items and request a quota increase (done). Add a client-side rate limiter that stays under the quota with graceful degradation, and alert on approaching the downstream limit.",
    "should_escalate": false
  }
}
