  "synthetic_deploys": [],
  "ground_truth": {
    "root_cause": "The activity table grew from ~700M to ~1.1B rows over the past week. The frequently-run q_feed_recent query still uses the same (user_id, created_at) index, but the amount of data it reads per user has grown to the point that its working set no longer fits in the database buffer cache, so most reads now hit disk. Query p95 latency jumped from ~120ms to ~2.4s and the resulting I/O wait pushed feed-db CPU to 90%, timing out feed requests. There was no deploy or schema change - the trigger is data growth crossing a cache-fit threshold. Recovery required constraining the query's scan range (a 14-day partial index) and trimming old rows.",
    "evidence_path": [
      "feed-db WARN: q_feed_recent p95 latency 2.4s vs ~120ms a week ago; disk reads per query up sharply",
      "feed-db WARN: the activity table is now 1.1B rows, up from ~700M a week ago; the per-user scan range has grown",
      "feed-api requests time out; feed-db CPU 90%, dominated by I/O wait from q_feed_recent",
      "no deploy or schema change; the query plan is unchanged - the working set no longer fits in the buffer cache",
      "latency returns to ~150ms after a 14-day partial index and a retention job are added"
    ],
    "fix": "Add a partial index limiting q_feed_recent to recent rows and a retention job to trim old activity (done). Add plan and working-set monitoring on the top queries, and size the buffer cache for the real working set or partition the activity table by time.",
    "should_escalate": false
  }
}
