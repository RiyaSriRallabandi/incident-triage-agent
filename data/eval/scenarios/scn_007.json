  "synthetic_deploys": [],
  "ground_truth": {
    "root_cause": "The TLS certificate for auth-service's token endpoint reached its expiry (notAfter = 2026-10-01T00:00:00Z) and was not renewed. Starting exactly at that wall-clock time, clients rejected the expired certificate during the TLS handshake, so every login and token-issuance request failed. There was no deploy or config change - the trigger was the calendar. Recovery required installing and reloading the renewed certificate.",
    "evidence_path": [
      "auth-service ERROR at 00:00: TLS handshake failures, certificate expired (notAfter=2026-10-01T00:00:00Z)",
      "the failure begins exactly at the round wall-clock time 00:00 UTC",
      "no deploys in 6 days and no config changes",
      "login_success_rate drops to 0 and TLS handshake errors spike",
      "recovery immediately after the renewed certificate is installed and reloaded"
    ],
    "fix": "Install and reload the renewed certificate (done). Add expiry monitoring that alerts 30/14/7 days ahead, automate renewal and reload, and stagger certificate expiry dates across services.",
    "should_escalate": false
  }
}
