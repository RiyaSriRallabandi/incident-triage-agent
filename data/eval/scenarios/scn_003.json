  "synthetic_deploys": [],
  "ground_truth": {
    "root_cause": "During planned index-tier capacity maintenance, an operator ran a capacity-removal command with an incorrect argument and removed 48 storage nodes instead of 4. That dropped the object-store index subsystem below quorum, forcing a multi-hour full restart of the index and placement subsystems. Every service depending on object reads and writes (media-api, uploads-worker) failed or degraded until object-store recovered.",
    "evidence_path": [
      "object-store WARN at 18:05: capacity removal command executed with nodes_removed=48 (requested=4)",
      "object-store index subsystem drops below quorum and enters recovery at 18:06",
      "media-api and uploads-worker begin failing object-store GET/PUT calls at 18:07-18:08",
      "object-store availability falls to ~12%",
      "object-store CRITICAL at 18:10: index and placement subsystems need a full multi-hour restart"
    ],
    "fix": "Complete the subsystem restart / restore the removed capacity. Add guardrails to the capacity tooling: cap how many nodes a single command can remove, require second-operator confirmation above a threshold, and refuse execution when the removal would take a subsystem below quorum.",
    "should_escalate": false
  }
}
