  "synthetic_deploys": [],
  "ground_truth": {
    "root_cause": "The external tax-calculation provider (api.taxly.io) had a major outage starting ~13:12 UTC, confirmed on its status page. checkout-api calls the provider for a tax quote on every checkout; those calls returned 503 and then timed out, so up to ~60% of checkout attempts failed at the tax step. The failure is isolated to the tax-calc integration - payments and inventory calls stayed healthy - and there were no deploys. The fix belongs to the provider; the mitigation was to fall back to cached tax rates.",
    "evidence_path": [
      "checkout-api WARN: tax-calc provider api.taxly.io returning 503, then timing out",
      "taxly.io status page confirms a major outage since 13:12 UTC",
      "tax_calc_success_rate collapses to ~10% and checkout_success_rate drops to ~38% at the tax step",
      "no deploys today; payments and inventory calls remain healthy - the failure is isolated to one dependency",
      "checkout recovers to ~95% once a cached-rate fallback is enabled"
    ],
    "fix": "Enable the cached-rate fallback for tax quotes (done). Add a circuit breaker around the tax-calc client, cache recent rates for graceful degradation, monitor the provider's status feed, and escalate to the provider for a timeline.",
    "should_escalate": false
  }
}
