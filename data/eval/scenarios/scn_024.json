  "synthetic_deploys": [],
  "ground_truth": {
    "root_cause": "The CDN provider serving static assets had degraded performance at its Frankfurt and Amsterdam edge locations starting ~16:15 UTC (confirmed on the provider's status page). EU users experienced slow or failed asset loads - error rate up to ~35%, p95 latency ~4s - so pages rendered broken for them. The origin asset servers and all API endpoints were healthy; the problem was confined to the CDN edge in EU. Recovery came when the provider shifted EU traffic to alternate POPs.",
    "evidence_path": [
      "rum-monitor: asset load failures rise to ~35% specifically in EU regions while other regions stay normal",
      "CDN provider status reports degraded performance at FRA and AMS edge locations since 16:15 UTC",
      "asset_p95_latency in EU climbs from ~120ms to ~4s",
      "origin asset serving and API endpoints are confirmed healthy - the failure is CDN-edge only and EU only",
      "recovery after the provider shifts EU traffic to alternate POPs"
    ],
    "fix": "Escalate to the CDN provider (their fix). Configure multi-CDN failover for static assets so a single provider's regional POP failure can be routed around, and keep an origin-direct fallback for critical assets.",
    "should_escalate": false
  }
}
