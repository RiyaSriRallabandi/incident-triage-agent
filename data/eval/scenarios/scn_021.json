  "synthetic_deploys": [],
  "ground_truth": {
    "root_cause": "The shared Redis cluster used for sessions and hot caches lost its primary node (redis-01), and automatic failover to redis-02 stalled on a split-brain guard, so the cache was unavailable cluster-wide. Every read that would have been a cache hit fell through to the origin databases. That cache-miss stampede pushed users-db to its connection limit (480/500), so query latency climbed and dependent services (profile-api, web-frontend auth) timed out - a thundering herd triggered by the cache outage, not by any change on the services themselves. Recovery required manually promoting redis-02 and letting the cache warm.",
    "evidence_path": [
      "session-store ERROR: redis-01 unresponsive and automatic failover to redis-02 did not complete",
      "cache_availability drops to 0 cluster-wide; all reads fall through to origin databases",
      "users-db connection utilization jumps to ~98% (480/500) from cache-miss traffic",
      "profile-api and web-frontend auth start timing out; profile-api error rate ~25%",
      "recovery after the operator manually promotes redis-02 and the cache warms"
    ],
    "fix": "Manually promote redis-02 and warm the cache (done). Fix failover so the split-brain guard cannot indefinitely block promotion, add request coalescing / stale-while-revalidate to blunt the herd on a cache outage, and set per-caller database connection limits.",
    "should_escalate": false
  }
