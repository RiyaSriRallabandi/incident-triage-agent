  "synthetic_deploys": [],
  "ground_truth": {
    "root_cause": "The managed DNS provider hosting the company's public DNS zones was hit by a large DDoS starting ~11:58 UTC (confirmed by the provider). External resolution of the company's own domains - and of some third-party endpoints on the same provider - became unreliable, dropping to ~55% success from multiple regions, so users could not reliably reach the site and ~20% of outbound third-party calls failed at DNS resolution. Internal DNS and the origin servers were healthy; the failure was entirely at the external authoritative DNS layer, which the company does not operate. The mitigation was to activate a secondary DNS provider for critical zones.",
    "evidence_path": [
      "edge-monitor: external DNS resolution success for the company's domain drops to ~60% from multiple regions",
      "the DNS provider reports a large DDoS against its infrastructure since 11:58 UTC",
      "api-gateway sees intermittent resolution failures for third-party endpoints; ~20% of outbound calls fail to resolve",
      "origin servers and internal DNS are confirmed healthy - failures are all at the external authoritative layer",
      "resolution recovers after a secondary DNS provider is activated for critical zones"
    ],
    "fix": "Activate a secondary DNS provider for critical zones (done). Run authoritative DNS across two independent providers permanently, and cache last-known-good resolutions for critical third-party endpoints.",
    "should_escalate": false
  }
}
