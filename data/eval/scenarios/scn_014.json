  "ground_truth": {
    "root_cause": "Deploy e4f5a6b refactored the product-detail assembly path and removed the caching decorator around the per-product lookup. Requests that previously served from cache (94% hit rate) now made a fresh database query per product, raising product-api's database read volume ~12x. The database could not keep up, so p95 latency climbed to ~3.2s and ~4% of requests timed out. Recovery on rollback.",
    "evidence_path": [
      "deploy e4f5a6b to product-api at 10:20 (product detail assembly refactor)",
      "product-api cache hit rate collapses from 94% to 3% immediately after the deploy",
      "products-db read QPS rises ~12x (800 -> 9600)",
      "product-api p95 latency climbs to ~3.2s with ~4% timeouts",
      "cache hit rate and latency recover on rollback"
    ],
    "fix": "Roll back e4f5a6b (done). Re-apply the refactor with the cache decorator restored, add a test asserting the product-detail path stays cached, and alert on a sudden cache-hit-rate drop.",
    "should_escalate": false
  }
}
