  "synthetic_deploys": [],
  "ground_truth": {
    "root_cause": "A config reload on the service-discovery cluster corrupted its health-check subsystem, which then returned empty or partial backend lists for ~30% of services. Clients querying discovery (orders-api and others) saw '0 healthy instances' for dependencies like payments-api that were actually healthy, and stopped routing to them, so those calls all failed. Nothing was wrong with the backend services - the platform's service catalog was stale. Recovery required rolling back the config reload and re-syncing the catalog from a healthy replica.",
    "evidence_path": [
      "service-discovery WARN at 10:00: config reload applied, catalog re-sync in progress",
      "service-discovery ERROR: health-check subsystem returning empty results for 30% of services after the reload",
      "orders-api sees 0 healthy instances for payments-api and fails all payment calls, though payments-api is healthy",
      "discovery_catalog_completeness drops to ~40% and dependent error rates rise",
      "recovery after the config reload is rolled back and the catalog re-synced from a healthy replica"
    ],
    "fix": "Roll back the config reload and re-sync the catalog (done). Validate discovery config changes against a canary before fleet apply, have clients keep last-known-good backends when a list suddenly drops to zero, and alert on catalog completeness.",
    "should_escalate": false
  }
}
