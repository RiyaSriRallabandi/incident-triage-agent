  "synthetic_deploys": [],
  "ground_truth": {
    "root_cause": "The database's server-side connection limit (max_connections = 500) was reached. Each orders-service instance holds a static pool of 10 connections; the fleet had grown over the week and an autoscale from 40 to 52 instances that morning brought total pool demand to 52 x 10 = 520, exceeding 500. The database began refusing new connections ('too many clients already'), so ~15% of requests failed to acquire a connection. There was no code deploy - the cause is cumulative connection demand crossing the fixed limit, tipped over by the morning's scale-up. Recovery required lowering the per-instance pool size and raising max_connections.",
    "evidence_path": [
      "autoscaler INFO: orders-service scaled 40 -> 52 instances that morning",
      "orders-db WARN: connection count 495/500 (max_connections), refusing new connections",
      "orders-service ERROR: 'too many clients already'; ~15% of requests fail to acquire a DB connection",
      "orders-db notes total pool demand 52 x 10 = 520 exceeds max_connections 500",
      "refusals stop after the per-instance pool is lowered to 8 and max_connections raised to 600"
    ],
    "fix": "Lower the per-instance pool and raise max_connections (done). Put a connection pooler (e.g. PgBouncer) between the fleet and the database so server-side connections do not scale linearly with instance count, and alert when connection count approaches the limit.",
    "should_escalate": false
  }
}
