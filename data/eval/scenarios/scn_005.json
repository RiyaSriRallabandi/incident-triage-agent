  "synthetic_deploys": [],
  "ground_truth": {
    "root_cause": "A backbone network config push withdrew the route advertisements for the subnet hosting the authoritative DNS servers (dns-auth, 10.2.0.0/16). With the nameservers unreachable, DNS resolution failed globally, so every service that has to resolve a hostname (api-gateway, edge-lb) failed and the edge served 503s for all traffic. Recovery required manually re-advertising the withdrawn prefixes.",
    "evidence_path": [
      "network-automation WARN at 15:40: config push withdrew prefixes for dns-auth (10.2.0.0/16)",
      "dns-auth authoritative nameservers become unreachable from the edge at 15:41",
      "dns_resolution_success_rate collapses from ~99.9% to ~2%",
      "api-gateway and edge-lb fail all hostname lookups (SERVFAIL) and serve 503s",
      "recovery after the withdrawn prefixes are re-advertised at ~15:55"
    ],
    "fix": "Re-advertise the withdrawn prefixes (done). Add a guard to the network automation that refuses a push removing the last route to a critical subnet (DNS, auth), keep an out-of-band management path that does not depend on production DNS, and stagger backbone changes.",
    "should_escalate": false
  }
}
