  "synthetic_deploys": [],
  "ground_truth": {
    "root_cause": "A user uploaded a decompression-bomb image: a ~40KB file that declares 48000x48000 pixel dimensions. image-resizer attempted to fully decode it, consuming enormous CPU and holding a worker for tens of seconds per attempt. The client retried the same asset ~140 times, so many workers were simultaneously stuck on oversized-decode jobs, CPU saturated, and the resize queue backed up for all users. There was no deploy - the trigger was the crafted input plus the absence of a decoded-size guard. Recovery required adding a max-decoded-dimension check and blocklisting the asset.",
    "evidence_path": [
      "image-resizer resize jobs suddenly take >30s against a <500ms baseline and worker CPU climbs",
      "image-resizer ERROR: a 40KB asset declares 48000x48000 px and its decode exceeds 60s",
      "the same asset was resubmitted ~140 times by client retries",
      "all workers become stuck on oversized-decode jobs; CPU pins and the queue grows to 9000",
      "no deploy; recovery after a max-decoded-dimension guard is added and the asset is blocklisted"
    ],
    "fix": "Add a decoded-dimension / pixel-count limit before decoding and reject oversized images (done). Blocklist the offending asset, add per-job CPU and time budgets, and rate-limit repeated submissions of the same asset.",
    "should_escalate": false
  }
}
