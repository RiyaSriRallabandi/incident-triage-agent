  "ground_truth": {
    "root_cause": "A scheduled rotation of the internal mTLS certificate authority distributed a new root, but roughly 30% of service-mesh pods failed to pick up the new trust bundle. Calls between pods on the new root and pods still on the old root failed certificate validation ('signed by unknown authority'), producing a partial (~35%) error rate on internal calls that matches the fraction of stale pods. Recovery required forcing a trust-bundle refresh on the lagging pods.",
    "evidence_path": [
      "mesh-control INFO at 09:30: scheduled internal CA rotation completed",
      "orders-api mTLS calls to inventory-api start failing at 09:33 with 'certificate signed by unknown authority'",
      "mesh-control detects trust-bundle version skew: 12 of 40 pods still on the previous root",
      "mtls_validation_error_rate and orders-api error_rate rise to ~30%, matching the stale-pod fraction",
      "recovery after a forced trust-bundle refresh on the lagging pods"
    ],
    "fix": "Force the trust-bundle refresh on lagging pods (done). Make CA rotation two-phase: distribute and confirm the new root on 100% of pods before switching signing to it, and add a pre-cutover check that blocks the rotation on any version skew.",
    "should_escalate": false
  }
