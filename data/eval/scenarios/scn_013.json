  "ground_truth": {
    "root_cause": "The ingress-controller was upgraded from 3.x to 4.x (deploy b1c2d3e). Version 4.x changed how a routing annotation is interpreted and silently ignored the legacy 'route.class' annotation still used by ~40% of services. Those services' route rules stopped matching any backend, so the ingress returned 503 (no route) for them. Services already on the new annotation form were unaffected. Recovery required rolling back the ingress-controller.",
    "evidence_path": [
      "deploy b1c2d3e at 16:00 upgrades ingress-controller 3.11 -> 4.2 fleet-wide",
      "ingress-controller WARN: 42 route rules no longer match a backend; legacy 'route.class' annotation ignored in 4.x",
      "web-frontend calls to orders-api and payments-api return 503 (no route)",
      "active_route_rules drops from ~105 to ~63 and http_5xx_rate rises to ~40%",
      "recovery after the ingress-controller is rolled back to 3.11"
    ],
    "fix": "Roll back the ingress-controller (done). Before re-upgrading, migrate every service to the 4.x annotation form and add a pre-upgrade check that fails if any route rule would become unmatched.",
    "should_escalate": false
  }
}
