  "synthetic_deploys": [],
  "ground_truth": {
    "root_cause": "A routine auto-analyze, triggered after a ~30M-row bulk import into the events table, updated the table statistics, and the query planner then switched a frequently-run dashboard query (q_dashboard_summary) from an index scan to a sequential scan on the 200M-row events table. That query's latency jumped from ~40ms to over 8s, and the repeated sequential scans drove database CPU to 96%, slowing every other query sharing the database. There was no deploy - the trigger was the statistics refresh changing the plan. Recovery required pinning the good (index) plan for that query.",
    "evidence_path": [
      "reporting-db INFO ~10 min before onset: auto-analyze ran on the events table after a ~30M-row bulk import",
      "reporting-db WARN: q_dashboard_summary latency 8s+ vs a ~40ms baseline, now doing a sequential scan on events (200M rows)",
      "reporting-db ERROR: plan regression confirmed - the query switched from index scan to seq scan after the stats update",
      "db_cpu_utilization climbs to 96% from the repeated sequential scans; other queries slow from contention",
      "latency returns to ~45ms after the plan is pinned for that query"
    ],
    "fix": "Pin the index plan for q_dashboard_summary (done). Investigate why the planner's cost estimate favoured a seq scan after ANALYZE (stale or skewed stats, missing extended statistics), add plan-regression monitoring on the top queries, and control when ANALYZE runs on large tables after bulk imports.",
    "should_escalate": false
  }
}
