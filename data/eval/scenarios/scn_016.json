{
  "id": "scn_016",
  "category": "resource_exhaustion",
  "difficulty": "hard",
  "title": "Unbounded in-memory dedup set leaks memory until the worker OOM-loops",
  "source_url": "https://sre.google/sre-book/addressing-cascading-failures/",
