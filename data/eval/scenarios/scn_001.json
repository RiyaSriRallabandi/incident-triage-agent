    }
  ],
  "ground_truth": {
    "root_cause": "A newly deployed WAF managed-rule set (commit 7f3a9c1) contained a rule (100417) with a catastrophically backtracking regular expression. Evaluating that pattern against normal request traffic drove edge-proxy worker CPU to saturation within about a minute, so requests queued and then failed with 502s across effectively all traffic.",
    "evidence_path": [
      "deploy 7f3a9c1 to edge-proxy at 13:42 rolls out a new WAF managed ruleset",
      "edge-proxy CPU climbs from ~35% to 100% beginning ~13:42:20, immediately after the deploy",
      "waf-engine ERROR at 13:44:30: regex evaluation exceeded its time budget on managed rule 100417 (nested quantifiers)",
      "edge-proxy 5xx rate rises to ~62% as workers saturate and the request queue grows",
      "CPU and 5xx rate recover after the WAF ruleset is rolled back at ~13:52"
    ],
    "fix": "Roll back the WAF ruleset to the previous version. Add a regex-complexity / backtracking check and a per-rule CPU budget to the rule-deployment pipeline, and canary WAF rule changes on a small fraction of traffic before global rollout.",
    "should_escalate": false
  }
}
