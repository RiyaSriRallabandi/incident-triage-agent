  "synthetic_deploys": [],
  "ground_truth": {
    "root_cause": "A security-group change (CR-4821) intended to tighten egress rules removed the rule permitting payments-gateway to reach the external payment processor's IP range. DNS still resolved, but TCP connections to the processor could no longer be established, so every payment authorization timed out. Non-payment traffic was unaffected. Recovery required rolling back the change.",
    "evidence_path": [
      "cloud-infra INFO at 11:05: security group sg-pay-egress updated (CR-4821), one rule removed",
      "payments-gateway outbound connections to the processor start timing out at 11:07",
      "payments-gateway notes DNS resolves but TCP connect never completes - a network-path failure, not a DNS failure",
      "payment_auth_success_rate falls to 0 and outbound connect errors spike",
      "recovery after CR-4821 is rolled back at ~11:25"
    ],
    "fix": "Roll back CR-4821 (done). Review security-group changes that affect payment egress against a known-good allowlist, test them in staging, and add synthetic monitoring that authorizes a test transaction end to end.",
    "should_escalate": false
  }
}
