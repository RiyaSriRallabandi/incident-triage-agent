# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GEMINI_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=incident-triage-agent

# Set true to enable POST /investigate (live agent runs) in the web layer.
# Left false on the deployed demo so it never spends free-tier LLM quota.
ALLOW_LIVE_RUNS=false
